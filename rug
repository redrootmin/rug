# Глобальные переменные
SUPER_USER=""
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
VERSION="1.0"
NAME="RUG (Российская Утилита для Геймеров)"

# Функция для отображения справки
show_help() {
    echo "Использование: $0 [опции]"
    echo
    echo "Опции:"
    echo "  -gui <модуль>        Запуск графического окружения (доступные модули: gtk)"
    echo "  -style <стиль>       Применить стиль (доступные: gnome, gnome-panel, redroot, macos, ubuntu, linux-mint, touchscreen, notebook)"
    echo "  -app <приложения>    Установить приложения (доступные: amdvlk,furmark,gravitymark)"
    echo "  -conf <конфиги>      Применить конфигурации (доступные: swap90,hd7970,amdoverclock,ram16gb)"
    echo "  -install             Установить утилиту в систему"
    echo "  -h, --help           Показать эту справку"
    echo "  -v, --version        Показать версию"
    echo
}

# Функция для запроса пароля root
request_root_password() {
    if [ -z "$SUPER_USER" ]; then
        echo "Для выполнения некоторых скриптов требуется пароль root"
        read -s -p "Введите пароль root: " SUPER_USER
        echo
    fi
}

# Функция для запуска скриптов
run_scripts() {
    local type=$1
    local scripts=$2
    local folder=$3
    
    IFS=',' read -ra script_array <<< "$scripts"
    for script in "${script_array[@]}"; do
        script_path="$SCRIPT_DIR/$folder/${script}.sh"
        if [ -f "$script_path" ]; then
            echo "Запуск скрипта: $script_path"
            if [ "$type" == "conf" ]; then
                echo "$SUPER_USER" | sudo -S bash "$script_path"
            else
                bash "$script_path"
            fi
        else
            echo "скрипт $script отсутствует, пропускаем"
        fi
    done
}

# Функция для установки утилиты
install_rug() {
    local target_dir="$HOME/.local/bin"
    local target_file="$target_dir/rug"
    
    mkdir -p "$target_dir"
    
    cat > "$target_file" <<EOF
#!/bin/bash
"$SCRIPT_DIR/$(basename "$0")" "\$@"
EOF
    
    chmod +x "$target_file"
    echo "Утилита $NAME установлена в $target_file"
    echo "Теперь вы можете запускать её из любой директории командой 'rug'"
}

# Обработка аргументов
process_args() {
    local has_gui=0
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            -gui)
                if [ $has_gui -eq 1 ]; then
                    echo "Ошибка: флаг -gui может быть использован только один раз"
                    show_help
                    exit 1
                fi
                has_gui=1
                if [ -z "$2" ]; then
                    echo "Ошибка: после -gui должно следовать название модуля"
                    show_help
                    exit 1
                fi
                run_scripts "gui" "$2" "gui"
                shift 2
                # После -gui не должно быть других флагов
                if [ $# -gt 0 ]; then
                    echo "Ошибка: после -gui не может быть других флагов"
                    show_help
                    exit 1
                fi
                ;;
            -style)
                if [ -z "$2" ]; then
                    echo "Ошибка: после -style должен следовать субфлаг"
                    show_help
                    exit 1
                fi
                run_scripts "style" "$2" "style"
                shift 2
                ;;
            -app)
                if [ -z "$2" ]; then
                    echo "Ошибка: после -app должны следовать субфлаги через запятую"
                    show_help
                    exit 1
                fi
                run_scripts "app" "$2" "app"
                shift 2
                ;;
            -conf)
                if [ -z "$2" ]; then
                    echo "Ошибка: после -conf должны следовать субфлаги через запятую"
                    show_help
                    exit 1
                fi
                request_root_password
                run_scripts "conf" "$2" "conf"
                shift 2
                ;;
            -install)
                install_rug
                exit 0
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                echo "$NAME версия $VERSION"
                exit 0
                ;;
            *)
                echo "Неизвестный аргумент: $1"
                show_help
                exit 1
                ;;
        esac
    done
}

# Главная функция
main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi
    
    process_args "$@"
}

# Запуск программы
main "$@"
